{
  "streams": [
    {
      "stream": {
        "name": "users",
        "json_schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "email": {
              "type": "string"
            },
            "first_name": {
              "type": "string"
            },
            "last_name": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "ssn": {
              "type": "string"
            },
            "salary": {
              "type": "number"
            },
            "department": {
              "type": "string"
            }
          }
        }
      },
      "sync_mode": "full_refresh",
      "destination_sync_mode": "overwrite"
    }
  ]
}
